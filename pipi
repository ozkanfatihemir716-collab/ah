            nameL.Position = UDim2.new(0, 6, 0, 2)
            nameL.BackgroundTransparency = 1
            nameL.TextColor3 = Color3.fromRGB(255, 255, 255)
            nameL.Font = Enum.Font.GothamBold
            nameL.TextSize = 10
            nameL.TextXAlignment = Enum.TextXAlignment.Left
            nameL.Text = p.Name
            local stateL = Instance.new("TextLabel", f)
            stateL.Size = UDim2.new(0.5, -6, 0, 12)
            stateL.Position = UDim2.new(0.5, 0, 0, 2)
            stateL.BackgroundTransparency = 1
            stateL.TextColor3 = Color3.fromRGB(100, 200, 150)
            stateL.Font = Enum.Font.Gotham
            stateL.TextSize = 9
            stateL.TextXAlignment = Enum.TextXAlignment.Right
            local infoL = Instance.new("TextLabel", f)
