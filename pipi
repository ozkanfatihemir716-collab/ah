local Karvis = {
    enabled = true, lastCheck = 0, gcTimer = 0, lastHealTime = 0,
    fpsHistory = {}, trendHistory = {}, mode = "normal",
    tier = 0,
    savedQuality = nil, savedSarvisRate = 0.15, savedFpsCap = 240,
