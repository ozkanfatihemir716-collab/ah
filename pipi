-- ==================== ANA LOOP ====================
local sarvisListUpdate = 0
RunService.Heartbeat:Connect(function(dt)
    espTick = espTick + dt; dodgeTick = dodgeTick + dt
    ragdollTick = ragdollTick + dt; staminaTick = staminaTick + dt
    lagTick = lagTick + dt

    karvisUpdate(dt)
    sarvisUpdate(dt)
    sarvisAutoTP()

    sarvisListUpdate = sarvisListUpdate + dt
    if sarvisListUpdate >= 0.4 then
        sarvisListUpdate = 0
        if currentTab == "s" then pcall(updateSarvisTargets) end
    end

    if G.Float and floatBodyPos then
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local moveDir = Vector3.new(0, 0, 0)
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + workspace.CurrentCamera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - workspace.CurrentCamera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - workspace.CurrentCamera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + workspace.CurrentCamera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end
                if moveDir.Magnitude > 0 then moveDir = moveDir.Unit * 20 end
                floatBodyPos.Position = hrp.Position + moveDir * dt
            end
        end
    end

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum then return end
    if myHum.Health <= 0 then return end

    local now = tick()
    if now - nearestCache.lastUpdate >= 0.1 then
        nearestCache.lastUpdate = now
        local nearest, minDist = nil, 200
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local d = (myHrp.Position - root.Position).Magnitude
                    if d < minDist then minDist = d; nearest = p end
                end
            end
        end
        nearestCache.target = nearest
        nearestCache.dist = minDist
    end

    local nearest = nearestCache.target
    local minDist = nearestCache.dist
    if nearest then
        local valid = false
        if nearest.Character then
            local root = nearest.Character:FindFirstChild("HumanoidRootPart")
            local hum = nearest.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                minDist = (myHrp.Position - root.Position).Magnitude
                valid = true
            end
        end
        if not valid then nearest = nil; minDist = 200 end
    end

    backTpCooldown = backTpCooldown - dt
    if G.BackTP and backTpCooldown <= 0 and nearest then
        if minDist >= 1.5 and minDist <= 8 then
            doBackTP(nearest)
            backTpCooldown = 3
        end
    end

    if G.Dash then
        dashCooldown = dashCooldown - dt
        if dashCooldown <= 0 and nearest and minDist < 1.5 then
            local tHrp = nearest.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                local frontPos = tHrp.Position + tHrp.CFrame.LookVector * 2
                myHrp.CFrame = CFrame.lookAt(frontPos, tHrp.Position)
                myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                dashCooldown = 0.4
            end
        end
    end

    if dodgeTick >= 1 then
        dodgeTick = 0
        if G.DodgeAttack then
            myHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, 0.3)
        end
    end

    if ragdollTick >= 0.1 then
        ragdollTick = 0
        if G.NoRagdoll then
            pcall(function()
                myHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                myHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            end)
            local state = myHum:GetState()
            if state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown then
                pcall(function() myHum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            end
            if myHum.PlatformStand then myHum.PlatformStand = false end
        end
    end

    if staminaTick >= 0.5 then
        staminaTick = 0
        if G.InfStamina then
            for _, name in ipairs({"Stamina","stamina","StaminaValue","Energy","energy"}) do
                local v = myChar:FindFirstChild(name, true)
                if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                    if v.Value < v.MaxValue then v.Value = v.MaxValue end
                end
            end
        end
    end

    if G.AutoLag and fps < 10 then
        if lagTick >= 4 then
            lagTick = 0
            local cands = {}
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if tHrp then
                        local d = (myHrp.Position - tHrp.Position).Magnitude
                        if d >= 7 and d <= 10 then table.insert(cands, p) end
                    end
                end
            end
            if #cands > 0 then lagTarget = cands[math.random(1, #cands)]
            else lagTarget = nil end
        end
        if lagCooldown > 0 then lagCooldown = lagCooldown - dt end
        if lagCooldown <= 0 and lagTarget then
            local tChar = lagTarget.Character
            if tChar then
                local tHrp = tChar:FindFirstChild("HumanoidRootPart")
                if tHrp then
                    local orig = tHrp.CFrame
                    local shake = Vector3.new(math.random(-2,2), math.random(-1,1), math.random(-2,2))
                    tHrp.CFrame = orig * CFrame.new(shake)
                    task.delay(0.05, function()
                        if tHrp and tHrp.Parent then tHrp.CFrame = orig end
                    end)
                    lagCooldown = 0.5
                end
            else lagTarget = nil end
        end
    end

    -- ESP update: espRate kontrol, tier 4'te de çalışır (throttled)
    if G.ESP and espTick >= Karvis.espRate then
        espTick = 0
        for p, d in pairs(espData) do
            if not p.Parent or not d.bb or not d.bb.Parent
            or not d.character or not d.character.Parent then
                removeESPForPlayer(p)
            end
        end
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local char = p.Character
                if char then
                    local head = char:FindFirstChild("Head")
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if head and hum and hum.Health > 0 then
                        local d = espData[p]
                        if not d or not d.bb.Parent or d.bb.Adornee ~= head then
                            createESPForPlayer(p, char, head)
                            d = espData[p]
                        end
                        if d and d.hpLbl and d.hpLbl.Parent then
                            d.hpLbl.Text = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
                            d.hpLbl.TextColor3 = getHealthColor(hum)
                        end
                    elseif espData[p] then removeESPForPlayer(p) end
                elseif espData[p] then removeESPForPlayer(p) end
            end
        end
    end
end)

