            infoL.Position = UDim2.new(0, 6, 0, 17)
            infoL.BackgroundTransparency = 1
            infoL.TextColor3 = Color3.fromRGB(255, 200, 80)
            infoL.Font = Enum.Font.Gotham
            infoL.TextSize = 9
            infoL.TextXAlignment = Enum.TextXAlignment.Left
            infoL.Text = ""
            targetRows[p] = {frame=f, nameL=nameL, stateL=stateL, infoL=infoL}
            row = targetRows[p]
        end
        local d2 = Sarvis.targets[p]
        if d2 then
            row.nameL.Text = p.Name
            row.stateL.Text = string.format("%s | %.0fsp | %.0fm", d2.state or "?", d2.speed or 0, d2.dist or 0)
            local infoParts = {}
