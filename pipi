local function updateSarvisTargets()
    for p, row in pairs(targetRows) do
        if not p.Parent or not Sarvis.targets[p] then
            row.frame:Destroy()
            targetRows[p] = nil
        end
    end
    local count = 0
    for _ in pairs(Sarvis.targets) do count = count + 1 end
    if count == 0 then
        if not targetContainer:FindFirstChild("EmptyMsg") then
            local msg = Instance.new("TextLabel", targetContainer)
            msg.Name = "EmptyMsg"
            msg.Size = UDim2.new(1, 0, 0, 24)
            msg.BackgroundTransparency = 1
            msg.TextColor3 = Color3.fromRGB(120, 130, 140)
            msg.Font = Enum.Font.Gotham
            msg.TextSize = 10
            msg.Text = L("sarvis_empty")
            msg.TextXAlignment = Enum.TextXAlignment.Center
        end
        return
    end
    local em = targetContainer:FindFirstChild("EmptyMsg")
    if em then em:Destroy() end
    for p, d in pairs(Sarvis.targets) do
        local row = targetRows[p]
        if not row then
            local f = Instance.new("Frame", targetContainer)
            f.Size = UDim2.new(1, 0, 0, 34)
            f.BackgroundColor3 = Color3.fromRGB(35, 35, 44)
            f.BackgroundTransparency = 0.2
            Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
            local nameL = Instance.new("TextLabel", f)
