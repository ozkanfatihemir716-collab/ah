local function enforceStats()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if G.Speed then
        if math.abs(hum.WalkSpeed - Settings.WalkSpeed) > 0.1 then
            pcall(function() hum.WalkSpeed = Settings.WalkSpeed end)
        end
    end
    if G.Jump then
        if hum.UseJumpPower ~= true then pcall(function() hum.UseJumpPower = true end) end
        if math.abs(hum.JumpPower - Settings.JumpPower) > 0.1 then
            pcall(function() hum.JumpPower = Settings.JumpPower end)
        end
    end
end

RunService.Stepped:Connect(enforceStats)
RunService.Heartbeat:Connect(enforceStats)
RunService.RenderStepped:Connect(enforceStats)
pcall(function() RunService:BindToRenderStep("NOVE_WS_MASTER", 2147483647, enforceStats) end)

local function bindChangedSignals()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if G.Speed and math.abs(hum.WalkSpeed - Settings.WalkSpeed) > 0.1 then
            hum.WalkSpeed = Settings.WalkSpeed
        end
    end)
    hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
        if G.Jump and math.abs(hum.JumpPower - Settings.JumpPower) > 0.1 then
            hum.JumpPower = Settings.JumpPower
        end
    end)
    hum:GetPropertyChangedSignal("UseJumpPower"):Connect(function()
        if G.Jump and not hum.UseJumpPower then hum.UseJumpPower = true end
    end)
end

