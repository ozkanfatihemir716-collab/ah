local function doBackTP(target)
    if not target or not target.Character then return false end
    local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not tHrp then return false end
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum then return false end
    if myHum.Health <= 0 then return false end
    local tVel = tHrp.AssemblyLinearVelocity
    local backDir
    if tVel.Magnitude > 5 then
        backDir = -Vector3.new(tVel.X, 0, tVel.Z).Unit
    else
        local look = tHrp.CFrame.LookVector
        backDir = -Vector3.new(look.X, 0, look.Z).Unit
    end
    local targetPos = tHrp.Position + backDir * 2.5
    local finalPos = Vector3.new(targetPos.X, myHrp.Position.Y + 0.5, targetPos.Z)
    local newCF = CFrame.lookAt(finalPos, tHrp.Position)
    pcall(function()
        myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        myHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)
    local success = pcall(function() myChar:PivotTo(newCF) end)
    if not success then pcall(function() myHrp.CFrame = newCF end) end
    task.spawn(function()
        task.wait()
        if myHrp and myHrp.Parent then
            pcall(function()
                myHrp.CFrame = newCF
                myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end)
        end
    end)
    return true
end

