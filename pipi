-- ==================== SARVIS AI ====================
local Sarvis = {
    enabled = true, autoTP = true, showInfo = true, detectAbilities = true,
    analysisRate = 0.15, tpCooldown = 2.5, baseTpCooldown = 2.5,
    targets = {}, lastUpdate = 0, lastTP = 0,
}

local function sarvisAnalyze(p)
    if p == LocalPlayer then return end
    local char = p.Character
    if not char then Sarvis.targets[p] = nil; return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then Sarvis.targets[p] = nil; return end
    local d = Sarvis.targets[p]
    if not d then
        d = { velHistory = {}, firstSeen = tick(), hitCombo = 0, lastHealth = hum.Health }
        Sarvis.targets[p] = d
    end
    table.insert(d.velHistory, hrp.AssemblyLinearVelocity)
    if #d.velHistory > 8 then table.remove(d.velHistory, 1) end
    local avg = Vector3.new(0,0,0)
    for _, v in ipairs(d.velHistory) do avg = avg + v end
    d.avgVel = avg / math.max(1, #d.velHistory)
    d.speed = d.avgVel.Magnitude
    d.moveDir = d.speed > 2 and d.avgVel.Unit or Vector3.new(0,0,0)
    d.predictedPos = hrp.Position + d.avgVel * 0.3
    if hum.Health < d.lastHealth then
        d.hitCombo = d.hitCombo + 1
        d.lastHitTime = tick()
    end
    d.lastHealth = hum.Health
    if d.hitCombo > 0 and (tick() - (d.lastHitTime or 0)) > 2 then
        d.hitCombo = 0
    end
    d.lastPos = hrp.Position
    d.hrp = hrp
    d.hum = hum
    d.char = char
    local tool = char:FindFirstChildOfClass("Tool")
    d.tool = tool and tool.Name or nil
    d.ability = nil
    d.abilityCount = d.abilityCount or 0
    if Sarvis.detectAbilities then
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            local ok, playing = pcall(function() return animator:GetPlayingAnimationTracks() end)
            if ok and playing then
                for _, t in ipairs(playing) do
                    if t.Animation and t.Animation.Name then
                        d.ability = t.Animation.Name
                        d.abilityCount = d.abilityCount + 1
                        break
                    end
                end
            end
        end
    end
    d.state = "idle"
    if d.speed > 40 then d.state = "fast"
    elseif d.speed > 15 then d.state = "moving"
    elseif d.speed < 1 then d.state = "still" end
    local humState = hum:GetState()
    if humState == Enum.HumanoidStateType.Ragdoll then d.state = "ragdoll"
    elseif humState == Enum.HumanoidStateType.Jumping or humState == Enum.HumanoidStateType.Freefall then d.state = "air"
    elseif humState == Enum.HumanoidStateType.Physics then d.state = "stunned" end
    local threat = 0
    if d.tool then threat = threat + 30 end
    if d.ability then threat = threat + 20 end
    if d.speed > 30 then threat = threat + 15 end
    d.threat = threat
    local myChar = LocalPlayer.Character
    if myChar then
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        if myHrp then
            local dist = (myHrp.Position - hrp.Position).Magnitude
            d.dist = dist
            local score = 0
            if dist >= 1.5 and dist <= 18 then
                score = (18 - dist) * 2
                if d.ability then score = score + 25 end
                if d.state == "still" then score = score + 15 end
                if d.state == "ragdoll" then score = score + 35 end
                if d.state == "stunned" then score = score + 25 end
                if d.tool then score = score + 10 end
                if d.hitCombo > 2 then score = score - 15 end
                score = score - math.min(d.speed, 30)
            end
            d.score = score
        end
    end
end

local function sarvisUpdate(dt)
    if not Sarvis.enabled then return end
    Sarvis.lastUpdate = Sarvis.lastUpdate + dt
    if Sarvis.lastUpdate < Sarvis.analysisRate then return end
    Sarvis.lastUpdate = 0
    for _, p in pairs(Players:GetPlayers()) do
        sarvisAnalyze(p)
    end
    for p, d in pairs(Sarvis.targets) do
        if not p.Parent or not p.Character or not d.hum or d.hum.Health <= 0 then
            Sarvis.targets[p] = nil
        end
    end
    local myChar = LocalPlayer.Character
    if myChar then
        local myHum = myChar:FindFirstChildOfClass("Humanoid")
        if myHum and myHum.Health < myHum.MaxHealth * 0.5 then
            Sarvis.tpCooldown = Sarvis.baseTpCooldown * 0.6
        else
            Sarvis.tpCooldown = Sarvis.baseTpCooldown
        end
    end
end

local function sarvisAutoTP()
    if not Sarvis.enabled or not Sarvis.autoTP then return end
    if tick() - Sarvis.lastTP < Sarvis.tpCooldown then return end
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myHrp or not myHum or myHum.Health <= 0 then return end
    local best, bestScore = nil, 30
    for p, d in pairs(Sarvis.targets) do
        if d.score and d.score > bestScore and d.hrp and d.hrp.Parent then
            bestScore = d.score
            best = p
        end
    end
    if not best then return end
    local d = Sarvis.targets[best]
    if not d or not d.hrp or not d.hrp.Parent then return end
    local tHrp = d.hrp
    local predictivePos = d.predictedPos or tHrp.Position
    local backDir
    if d.moveDir.Magnitude > 0.1 then
        backDir = -d.moveDir
    else
        backDir = -tHrp.CFrame.LookVector
    end
    local backPos = predictivePos + backDir * 2.5
    local finalPos = Vector3.new(backPos.X, myHrp.Position.Y + 0.5, backPos.Z)
    local newCF = CFrame.lookAt(finalPos, predictivePos)
    pcall(function()
        myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        myHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)
    local ok = pcall(function() myChar:PivotTo(newCF) end)
    if not ok then pcall(function() myHrp.CFrame = newCF end) end
    task.spawn(function()
        task.wait()
        if myHrp and myHrp.Parent then
            pcall(function()
                myHrp.CFrame = newCF
                myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end)
        end
    end)
    Sarvis.lastTP = tick()
end

